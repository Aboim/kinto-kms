{
  "name": "kinto-kms-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:electron": "vite build && electron .",
    "build:electron": "vite build && electron-builder",
    "build:apk": "vite build && npx cap sync android && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.kintokms.desktop",
    "productName": "KINTO KMS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js",
      "server.js",
      "database.db"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
